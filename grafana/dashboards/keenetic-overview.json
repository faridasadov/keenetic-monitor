          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.site, r.name, s.online, s.wan_status, s.wan_ip, s.cpu_usage, s.ram_usage, s.updated_at FROM routers r LEFT JOIN router_status s ON s.router_id = r.id ORDER BY r.site, r.name;",
          "refId": "A"
        }
      ],
      "title": "Router Status",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__time(time), r.name AS metric, max(rx_bytes_total) AS value FROM router_metrics m JOIN routers r ON r.id = m.router_id WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "RX Bytes Total",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.site, r.name AS router, count(c.id) AS clients FROM routers r LEFT JOIN current_clients c ON c.router_id = r.id GROUP BY r.site, r.name ORDER BY clients DESC;",
          "refId": "A"
        }
      ],
      "title": "Connected Clients by Site",
      "type": "table"
    }
