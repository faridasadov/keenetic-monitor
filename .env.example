APP_NAME=keenetic-monitor
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://keenetic:keenetic@timescaledb:5432/keenetic_monitor
FERNET_KEY=replace-with-output-of-python-c-from-cryptography-fernet-import-Fernet-print-Fernet-generate_key-decode

COLLECTOR_ENABLED=true
ROUTER_POLL_WAN_SECONDS=2
ROUTER_POLL_CLIENTS_SECONDS=2
ROUTER_POLL_TRAFFIC_SECONDS=2
ROUTER_POLL_SYSTEM_SECONDS=2
ROUTER_OFFLINE_AFTER_FAILURES=3

RAW_RESPONSE_DIR=/app/raw-responses
